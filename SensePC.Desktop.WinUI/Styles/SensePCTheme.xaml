<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================== -->
    <!-- SensePC Theme - Website Design System for WinUI3                  -->
    <!-- ================================================================== -->

    <!-- ==================== COLOR PALETTE ==================== -->
    
    <!-- Primary Colors -->
    <Color x:Key="SensePrimaryBlue">#3B82F6</Color>
    <Color x:Key="SenseLinkBlue">#2530F0</Color>
    <Color x:Key="SenseFocusPurple">#5F4BF6</Color>
    
    <!-- Background Colors (Dark Theme) -->
    <Color x:Key="SenseBackgroundDark">#020816</Color>
    <Color x:Key="SenseCardBackground">#0A0F1A</Color>
    <Color x:Key="SenseSurfaceDark">#1E293B</Color>
    <Color x:Key="SenseElevatedSurface">#0F172A</Color>
    
    <!-- Text Colors -->
    <Color x:Key="SenseTextPrimary">#F8FAFC</Color>
    <Color x:Key="SenseTextSecondary">#94A3B8</Color>
    <Color x:Key="SenseTextMuted">#64748B</Color>
    <Color x:Key="SenseParagraph">#B9C2D5</Color>
    
    <!-- Border Colors -->
    <Color x:Key="SenseBorderDefault">#1E293B</Color>
    <Color x:Key="SenseBorderSubtle">#FFFFFF0A</Color>
    <Color x:Key="SenseBorderHover">#FFFFFF1A</Color>
    
    <!-- Gradient Accent Colors -->
    <Color x:Key="SenseGradientMagenta">#D971FF</Color>
    <Color x:Key="SenseGradientPurple">#4C55F8</Color>
    <Color x:Key="SenseGradientLavender">#8086F3</Color>
    <Color x:Key="SenseGradientBlue">#2701FF</Color>
    <Color x:Key="SenseGradientPink">#8F00BE</Color>
    
    <!-- Status Colors -->
    <Color x:Key="SenseSuccessGreen">#22C55E</Color>
    <Color x:Key="SenseWarningAmber">#F59E0B</Color>
    <Color x:Key="SenseErrorRed">#EF4444</Color>
    <Color x:Key="SenseInfoBlue">#0EA5E9</Color>
    
    <!-- Glass Effect Colors -->
    <Color x:Key="SenseGlassWhite">#FFFFFF0A</Color>
    <Color x:Key="SenseGlassBorder">#FFFFFF1A</Color>
    
    <!-- ==================== SOLID BRUSHES ==================== -->
    
    <SolidColorBrush x:Key="SensePrimaryBlueBrush" Color="{StaticResource SensePrimaryBlue}"/>
    <SolidColorBrush x:Key="SenseLinkBlueBrush" Color="{StaticResource SenseLinkBlue}"/>
    <SolidColorBrush x:Key="SenseFocusPurpleBrush" Color="{StaticResource SenseFocusPurple}"/>
    
    <SolidColorBrush x:Key="SenseBackgroundBrush" Color="{StaticResource SenseBackgroundDark}"/>
    <SolidColorBrush x:Key="SenseCardBackgroundBrush" Color="{StaticResource SenseCardBackground}"/>
    <SolidColorBrush x:Key="SenseSurfaceBrush" Color="{StaticResource SenseSurfaceDark}"/>
    <SolidColorBrush x:Key="SenseElevatedSurfaceBrush" Color="{StaticResource SenseElevatedSurface}"/>
    
    <SolidColorBrush x:Key="SenseTextPrimaryBrush" Color="{StaticResource SenseTextPrimary}"/>
    <SolidColorBrush x:Key="SenseTextSecondaryBrush" Color="{StaticResource SenseTextSecondary}"/>
    <SolidColorBrush x:Key="SenseTextMutedBrush" Color="{StaticResource SenseTextMuted}"/>
    <SolidColorBrush x:Key="SenseParagraphBrush" Color="{StaticResource SenseParagraph}"/>
    
    <SolidColorBrush x:Key="SenseBorderBrush" Color="{StaticResource SenseBorderDefault}"/>
    <SolidColorBrush x:Key="SenseBorderSubtleBrush" Color="{StaticResource SenseBorderSubtle}"/>
    <SolidColorBrush x:Key="SenseBorderHoverBrush" Color="{StaticResource SenseBorderHover}"/>
    
    <SolidColorBrush x:Key="SenseSuccessBrush" Color="{StaticResource SenseSuccessGreen}"/>
    <SolidColorBrush x:Key="SenseWarningBrush" Color="{StaticResource SenseWarningAmber}"/>
    <SolidColorBrush x:Key="SenseErrorBrush" Color="{StaticResource SenseErrorRed}"/>
    <SolidColorBrush x:Key="SenseInfoBrush" Color="{StaticResource SenseInfoBlue}"/>
    
    <SolidColorBrush x:Key="SenseGlassBackgroundBrush" Color="{StaticResource SenseGlassWhite}"/>
    <SolidColorBrush x:Key="SenseGlassBorderBrush" Color="{StaticResource SenseGlassBorder}"/>
    
    <!-- ==================== GRADIENT BRUSHES ==================== -->
    
    <!-- Primary Gradient (Purple to Magenta) -->
    <LinearGradientBrush x:Key="SenseGradientPrimaryBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource SenseGradientMagenta}" Offset="0.05"/>
        <GradientStop Color="{StaticResource SenseGradientPurple}" Offset="0.46"/>
        <GradientStop Color="{StaticResource SenseGradientLavender}" Offset="1.0"/>
    </LinearGradientBrush>
    
    <!-- Glow Border Gradient -->
    <LinearGradientBrush x:Key="SenseGradientGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource SenseGradientBlue}" Offset="0"/>
        <GradientStop Color="{StaticResource SenseGradientPink}" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Input Focus Gradient -->
    <LinearGradientBrush x:Key="SenseGradientInputFocusBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource SenseGradientLavender}" Offset="0"/>
        <GradientStop Color="{StaticResource SenseGradientPurple}" Offset="0.5"/>
        <GradientStop Color="{StaticResource SenseGradientMagenta}" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Subtle Accent Gradient -->
    <LinearGradientBrush x:Key="SenseGradientSubtleBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#1A3B82F6" Offset="0"/>
        <GradientStop Color="#1A8B5CF6" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Card Highlight Gradient -->
    <LinearGradientBrush x:Key="SenseCardHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0AFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ==================== TYPOGRAPHY ==================== -->
    
    <!-- Display/Hero Text -->
    <Style x:Key="SenseDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <!-- Page Title -->
    <Style x:Key="SensePageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextPrimaryBrush}"/>
    </Style>
    
    <!-- Section Header -->
    <Style x:Key="SenseSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextPrimaryBrush}"/>
    </Style>
    
    <!-- Card Title -->
    <Style x:Key="SenseCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextPrimaryBrush}"/>
    </Style>
    
    <!-- Body Text -->
    <Style x:Key="SenseBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <!-- Secondary/Muted Text -->
    <Style x:Key="SenseSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextSecondaryBrush}"/>
    </Style>
    
    <!-- Caption Text -->
    <Style x:Key="SenseCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextMutedBrush}"/>
    </Style>
    
    <!-- Large Value Display (for stats) -->
    <Style x:Key="SenseStatValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextPrimaryBrush}"/>
    </Style>

    <!-- ==================== CARD STYLES ==================== -->
    
    <!-- Glass Card Border -->
    <Style x:Key="SenseGlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SenseGlassBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SenseGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    
    <!-- Solid Card Border -->
    <Style x:Key="SenseSolidCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SenseCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SenseBorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    
    <!-- Elevated Card Border -->
    <Style x:Key="SenseElevatedCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SenseElevatedSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SenseBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24"/>
    </Style>
    
    <!-- Stat Card (for dashboard stats) -->
    <Style x:Key="SenseStatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SenseGlassBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SenseGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="MinWidth" Value="200"/>
    </Style>

    <!-- ==================== BUTTON STYLES ==================== -->
    
    <!-- Primary Gradient Button -->
    <Style x:Key="SensePrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SenseGradientPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    
    <!-- Secondary Button -->
    <Style x:Key="SenseSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SenseSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{StaticResource SenseBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    
    <!-- Ghost Button (transparent) -->
    <Style x:Key="SenseGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    
    <!-- Icon Button -->
    <Style x:Key="SenseIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextSecondaryBrush}"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ==================== STATUS BADGES ==================== -->
    
    <!-- Success Badge -->
    <Style x:Key="SenseSuccessBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#1A22C55E"/>
        <Setter Property="BorderBrush" Value="#3322C55E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    
    <!-- Warning Badge -->
    <Style x:Key="SenseWarningBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#1AF59E0B"/>
        <Setter Property="BorderBrush" Value="#33F59E0B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    
    <!-- Error Badge -->
    <Style x:Key="SenseErrorBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#1AEF4444"/>
        <Setter Property="BorderBrush" Value="#33EF4444"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    
    <!-- Info Badge -->
    <Style x:Key="SenseInfoBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#1A0EA5E9"/>
        <Setter Property="BorderBrush" Value="#330EA5E9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    
    <!-- Primary Badge -->
    <Style x:Key="SensePrimaryBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#1A3B82F6"/>
        <Setter Property="BorderBrush" Value="#333B82F6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- ==================== INPUT STYLES ==================== -->
    
    <!-- Text Input Style -->
    <Style x:Key="SenseTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SenseGlassBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SenseTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SenseBorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- ==================== SEPARATOR ==================== -->
    
    <Style x:Key="SenseSeparatorStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SenseBorderSubtleBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,16"/>
    </Style>

    <!-- ==================== SIDEBAR STYLES ==================== -->
    
    <!-- Sidebar Background Colors -->
    <Color x:Key="SidebarBackgroundDark">#010526</Color>
    <Color x:Key="SidebarBackgroundLight">#F0F4FF</Color>
    
    <!-- Sidebar Nav Item Colors -->
    <Color x:Key="NavItemActiveColor">#1D4ED8</Color>
    <Color x:Key="NavItemHoverDark">#1E293B</Color>
    <Color x:Key="NavItemHoverLight">#E0E7FF</Color>
    
    <!-- Sidebar Brushes (Dark Mode - default) -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundDark}"/>
    <SolidColorBrush x:Key="NavItemActiveBrush" Color="{StaticResource NavItemActiveColor}"/>
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="{StaticResource NavItemHoverDark}"/>
    
    <!-- Sidebar Gradient Border -->
    <LinearGradientBrush x:Key="SidebarBorderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A801BA" Offset="0"/>
        <GradientStop Color="#2530F0" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- NavigationView Style Overrides -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource SidebarBackgroundDark}"/>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource SidebarBackgroundDark}"/>
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="{StaticResource SidebarBackgroundDark}"/>
    
    <!-- NavigationViewItem Selected States -->
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource NavItemActiveColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource NavItemActiveColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2563EB"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1E40AF"/>
    
    <!-- NavigationViewItem Hover States -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{StaticResource NavItemHoverDark}"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{StaticResource SenseSurfaceDark}"/>
    
    <!-- NavigationViewItem Text Colors -->
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource SenseTextSecondary}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="White"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="White"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="White"/>

</ResourceDictionary>
