<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SensePC.Desktop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SensePC">

    <Grid x:Name="RootGrid">
        <!-- Login Frame (when NOT authenticated) -->
        <Frame x:Name="LoginFrame" Visibility="Visible" />
        
        <!-- Dashboard Layout with NavigationView (when authenticated) -->
        <NavigationView x:Name="NavView" 
                        Visibility="Collapsed"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded">
            
            <!-- Navigation Header with Logo (below toggle button) -->
            <NavigationView.PaneCustomContent>
                <Grid HorizontalAlignment="Stretch" Margin="0,8,0,16">
                    <Image Source="ms-appx:///Assets/sensepc-logo-dark.png" 
                           Height="70" Width="70" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Grid>
            </NavigationView.PaneCustomContent>

            <!-- Navigation Items -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavSensePC" Content="Sense PC" Tag="SensePC">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem x:Name="NavStorage" Content="Sense Cloud" Tag="Storage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem x:Name="NavUsers" Content="Users" Tag="Users">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem x:Name="NavBilling" Content="Billing" Tag="Billing">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItemSeparator/>
                
                <NavigationViewItem x:Name="NavSupport" Content="Support" Tag="Support">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem x:Name="NavTutorials" Content="Tutorials" Tag="Tutorials">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BE;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem x:Name="NavSecurity" Content="Security &amp; Privacy" Tag="Security">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Footer Items -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavNotifications" Content="Notifications" Tag="Notifications">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA8F;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="NotificationBadge" Value="0" Visibility="Collapsed"/>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSettings" Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem x:Name="NavProfile" Tag="Profile">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock x:Name="SidebarUserName" Text="Profile"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                
                <NavigationViewItemSeparator/>
                
                <NavigationViewItem x:Name="LogoutItem" Tag="Logout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" Foreground="#EF4444"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Sign out" Foreground="#EF4444"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Balance Card in PaneFooter -->
            <NavigationView.PaneFooter>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6" 
                        Padding="14,12"
                        Margin="12,8,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8EC;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Balance" FontSize="11" Opacity="0.6"/>
                            <TextBlock x:Name="SidebarBalanceText" Text="$0.00" FontWeight="SemiBold" FontSize="18"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </NavigationView.PaneFooter>

            <!-- Content Area with Session Sidebar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SessionSidebarColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Session Sidebar (appears when connected) -->
                <Border x:Name="SessionSidebar" 
                        Grid.Column="0" 
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Session Header -->
                        <Grid Grid.Row="0" Margin="12,12,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel x:Name="SessionHeaderExpanded" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Sessions" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <Button x:Name="CollapseSessionSidebarButton" 
                                    Grid.Column="1"
                                    Click="CollapseSessionSidebar_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Close sessions panel"
                                    Padding="6">
                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            </Button>
                        </Grid>

                        <!-- Session List -->
                        <ListView x:Name="SessionListView" 
                                  Grid.Row="1"
                                  SelectionMode="Single"
                                  SelectionChanged="SessionListView_SelectionChanged"
                                  Margin="4,0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,10" ToolTipService.ToolTip="{Binding SystemName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Ellipse Grid.Column="0" Width="8" Height="8" 
                                                 Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                 Margin="0,0,10,0"/>
                                        
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding SystemName}" 
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        
                                        <Button Grid.Column="2" 
                                                Tag="{Binding InstanceId}"
                                                Click="CloseSession_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                ToolTipService.ToolTip="Close session">
                                            <FontIcon Glyph="&#xE711;" FontSize="10"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Back Button -->
                        <Button x:Name="BackToPCListButton"
                                Grid.Row="2"
                                Content="Back to PC List"
                                Click="BackToPCList_Click"
                                HorizontalAlignment="Stretch"
                                Margin="8,8,8,12"
                                Padding="12,10"/>
                    </Grid>
                </Border>
                
                <!-- Content Frame and DCV Session -->
                <Grid Grid.Column="1">
                    <Frame x:Name="DashboardFrame" Padding="24"/>
                    
                    <Grid x:Name="DCVSessionContent" Visibility="Collapsed">
                        <!-- WebView2 will be added programmatically -->
                        <Grid x:Name="WebViewContainer"/>
                        
                        <!-- Right Side Control Panel (like website pc-viewer) -->
                        <Border x:Name="DCVControlPanel"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Width="220"
                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0"
                                Visibility="Visible">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Padding="12,12,8,8" 
                                      Background="{ThemeResource LayerFillColorAltBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" 
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4" 
                                            Width="32" Height="32">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Name" FontSize="10" Opacity="0.6" CharacterSpacing="50"/>
                                        <TextBlock x:Name="DCVPanelPCName" Text="—" FontSize="11" FontWeight="SemiBold" 
                                                   TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="2" 
                                            Click="CloseDCVPanel_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6"
                                            ToolTipService.ToolTip="Close panel">
                                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                    </Button>
                                </Grid>

                                <!-- Scrollable Content -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,12,12,0">
                                    <StackPanel Spacing="12">
                                        
                                        <!-- Connection Status Card -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Connection Status" FontSize="13" FontWeight="SemiBold"/>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Status" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                    <Border x:Name="DCVStatusBadge" Grid.Column="1" 
                                                            Background="#1522C55E" CornerRadius="4" Padding="8,2">
                                                        <TextBlock x:Name="DCVStatusText" Text="CONNECTED" FontSize="10" 
                                                                   Foreground="#22C55E" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Latency" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                                            CornerRadius="4" Padding="8,2">
                                                        <TextBlock x:Name="DCVLatencyText" Text="0ms" FontSize="10" FontFamily="Consolas"/>
                                                    </Border>
                                                </Grid>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="FPS" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                                            CornerRadius="4" Padding="8,2">
                                                        <TextBlock x:Name="DCVFpsText" Text="0" FontSize="10" FontFamily="Consolas"/>
                                                    </Border>
                                                </Grid>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Uptime" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                                            CornerRadius="4" Padding="8,2">
                                                        <TextBlock x:Name="DCVUptimeText" Text="0m" FontSize="10" FontFamily="Consolas"/>
                                                    </Border>
                                                </Grid>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Quality" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                                            CornerRadius="4" Padding="8,2">
                                                        <TextBlock x:Name="DCVQualityText" Text="0%" FontSize="10" FontFamily="Consolas"/>
                                                    </Border>
                                                </Grid>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Data" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                                            CornerRadius="4" Padding="8,2">
                                                        <TextBlock x:Name="DCVDataText" Text="0 MB" FontSize="10" FontFamily="Consolas"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Quality Settings Card -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Quality Settings" FontSize="13" FontWeight="SemiBold"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Quality Preset" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                                            CornerRadius="4" Padding="8,2">
                                                        <TextBlock Text="Auto" FontSize="10" FontFamily="Consolas"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Input & Devices Card -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <Border Padding="12,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                    <TextBlock Text="Input &amp; Devices" FontSize="13" FontWeight="SemiBold"/>
                                                </Border>
                                                <StackPanel Padding="12,8" Spacing="8">
                                                    <!-- Camera -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Camera" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                        <Button x:Name="DCVCameraButton" Click="DCVCamera_Click" Padding="6,2" Height="22">
                                                            <TextBlock x:Name="DCVCameraButtonText" Text="Enable" FontSize="10"/>
                                                        </Button>
                                                    </Grid>
                                                    <!-- Microphone -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Microphone" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                        <Button x:Name="DCVMicButton" Click="DCVMic_Click" Padding="6,2" Height="22">
                                                            <TextBlock x:Name="DCVMicButtonText" Text="Enable" FontSize="10"/>
                                                        </Button>
                                                    </Grid>
                                                    <!-- Keyboard -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Keyboard" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#1522C55E" CornerRadius="4" Padding="8,2">
                                                            <TextBlock Text="Enabled" FontSize="10" Foreground="#22C55E"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Mouse -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Mouse" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#1522C55E" CornerRadius="4" Padding="8,2">
                                                            <TextBlock Text="Enabled" FontSize="10" Foreground="#22C55E"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Audio -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Audio" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#1522C55E" CornerRadius="4" Padding="8,2">
                                                            <TextBlock Text="Enabled" FontSize="10" Foreground="#22C55E"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Touch -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Touch" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#1522C55E" CornerRadius="4" Padding="8,2">
                                                            <TextBlock Text="Enabled" FontSize="10" Foreground="#22C55E"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- USB (Desktop advantage) -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="USB" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#1522C55E" CornerRadius="4" Padding="8,2">
                                                            <TextBlock Text="Enabled" FontSize="10" Foreground="#22C55E"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- VR -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="VR" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                                            <TextBlock Text="Disabled" FontSize="10" Opacity="0.6"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Clipboard -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Clipboard Sync" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#1522C55E" CornerRadius="4" Padding="8,2">
                                                            <TextBlock Text="Enabled" FontSize="10" Foreground="#22C55E"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- File Transfer Card -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="File Transfer" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" 
                                                        Click="DCVFileTransfer_Click"
                                                        ToolTipService.ToolTip="Open File Storage"
                                                        Padding="6"
                                                        Width="28" Height="28">
                                                    <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Bottom Session Control -->
                                <Border Grid.Row="2" 
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="12">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Session Control" FontSize="11" FontWeight="SemiBold"/>
                                            
                                            <!-- Control Buttons Row -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Button Grid.Column="0" 
                                                        Click="DCVNewWindow_Click"
                                                        ToolTipService.ToolTip="Open in New Window"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,0,4,0"
                                                        Padding="0"
                                                        Height="32">
                                                    <FontIcon Glyph="&#xE78B;" FontSize="14"/>
                                                </Button>
                                                
                                                <Button Grid.Column="1" 
                                                        Click="DCVKeyboard_Click"
                                                        ToolTipService.ToolTip="On-Screen Keyboard (Ctrl+Win+O)"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="2,0"
                                                        Padding="0"
                                                        Height="32">
                                                    <FontIcon Glyph="&#xE765;" FontSize="14"/>
                                                </Button>
                                                
                                                <Button Grid.Column="2" 
                                                        x:Name="DCVFullscreenButton"
                                                        Click="DCVFullscreen_Click"
                                                        ToolTipService.ToolTip="Toggle Fullscreen"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="4,0,0,0"
                                                        Padding="0"
                                                        Height="32">
                                                    <FontIcon x:Name="DCVFullscreenIcon" Glyph="&#xE740;" FontSize="14"/>
                                                </Button>
                                            </Grid>
                                            
                                            <!-- Disconnect Button -->
                                            <Button x:Name="DCVDisconnectButton"
                                                    Click="DCVDisconnect_Click"
                                                    HorizontalAlignment="Stretch"
                                                    Height="36"
                                                    Background="#DC2626">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="White"/>
                                                    <TextBlock Text="Disconnect" Foreground="White" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Panel Toggle Handle (when panel is closed) -->
                        <Border x:Name="DCVPanelHandle"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="24"
                                Height="60"
                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,1,0,1"
                                CornerRadius="6,0,0,6"
                                Visibility="Collapsed"
                                PointerPressed="DCVPanelHandle_Click">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border x:Name="NoSessionSelected"
                                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE7F4;" FontSize="48" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Select a session" FontSize="18" FontWeight="SemiBold" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Click on a session in the sidebar to view it" 
                                           FontSize="13" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
