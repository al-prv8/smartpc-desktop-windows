<Page
    x:Class="SensePC.Desktop.WinUI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SensePC.Desktop.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side - Branding Area -->
        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60" MaxWidth="420">
                <!-- Logo -->
                <Image Source="ms-appx:///Assets/sensepc-logo-dark.png" 
                       Height="100" Width="100" Margin="0,0,0,24"
                       HorizontalAlignment="Left"/>
                
                <!-- Headline -->
                <TextBlock Text="High Performance Cloud PCs" 
                           Style="{StaticResource TitleLargeTextBlockStyle}"
                           TextWrapping="Wrap"/>
                
                <TextBlock Text="Deploy powerful virtual machines in seconds. Game, work, and create without hardware limitations." 
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"/>
                
                <!-- Stats Row -->
                <Grid Margin="0,40,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="99.9%" FontSize="28" FontWeight="Bold" 
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Uptime" Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="&lt;50ms" FontSize="28" FontWeight="Bold" 
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Latency" Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="10K+" FontSize="28" FontWeight="Bold" 
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Users" Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                
                <!-- Feature List -->
                <StackPanel Margin="0,40,0,0" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Instant deployment in under 60 seconds" 
                                   Style="{StaticResource BodyTextBlockStyle}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Connect from any device, anywhere" 
                                   Style="{StaticResource BodyTextBlockStyle}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Pay only for what you use" 
                                   Style="{StaticResource BodyTextBlockStyle}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Right Side - Login Form -->
        <Border Grid.Column="1" Width="420" Padding="48"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">
                    
                    <!-- Welcome Text -->
                    <TextBlock Text="Welcome back" 
                               Style="{StaticResource TitleLargeTextBlockStyle}"/>
                    <TextBlock Text="Sign in to access your Sense PC" 
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,8,0,32"/>

                    <!-- Email Field -->
                    <TextBlock Text="Email" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="EmailBox"
                             PlaceholderText="Enter your email"
                             Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Password Field -->
                    <TextBlock Text="Password" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,24,0,8"/>
                    <PasswordBox x:Name="PasswordBox"
                                 PlaceholderText="Enter your password"
                                 Password="{x:Bind ViewModel.Password, Mode=TwoWay}"/>

                    <!-- Error Message -->
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Foreground="Red" FontSize="12"
                               TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>

                    <!-- Forgot Password -->
                    <HyperlinkButton Content="Forgot your password?" 
                                     Click="ForgotPassword_Click"
                                     HorizontalAlignment="Right"
                                     Margin="0,12,0,0"/>

                    <!-- Login Button -->
                    <Button x:Name="LoginButton"
                            Command="{x:Bind ViewModel.SignInCommand}"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,24,0,0" Padding="12">
                        <TextBlock Text="{x:Bind ViewModel.IsBusy, Converter={StaticResource BusyToTextConverter}, Mode=OneWay}"/>
                    </Button>

                    <!-- Divider -->
                    <Grid Margin="0,32,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="or continue with" 
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,0"/>
                        <Border Grid.Column="2" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Social Login -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="GoogleLoginButton" Grid.Column="0" 
                                HorizontalAlignment="Stretch"
                                Click="GoogleLogin_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE774;" FontSize="16"/>
                                <TextBlock x:Name="GoogleButtonText" Text="Google"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AppleLoginButton" Grid.Column="2" 
                                HorizontalAlignment="Stretch"
                                Click="AppleLogin_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xF570;" FontSize="16"/>
                                <TextBlock x:Name="AppleButtonText" Text="Apple"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Sign Up Link -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                        <TextBlock Text="Don't have an account?" 
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <HyperlinkButton Content="Sign up" Click="SignUp_Click" Padding="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MFA Dialog -->
        <ContentDialog 
            x:Name="MfaDialog"
            Title="Two-Factor Authentication"
            PrimaryButtonText="Verify"
            SecondaryButtonText="Cancel"
            PrimaryButtonCommand="{x:Bind ViewModel.ConfirmMfaCommand}"
            SecondaryButtonCommand="{x:Bind ViewModel.CancelMfaCommand}">
            <StackPanel Spacing="16" Padding="8" MinWidth="320">
                <TextBlock 
                    Text="{x:Bind ViewModel.MfaType, Mode=OneWay, Converter={StaticResource MfaTypeToMessageConverter}}"
                    TextWrapping="Wrap"/>
                <TextBox 
                    PlaceholderText="Enter 6-digit code"
                    Text="{x:Bind ViewModel.MfaCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    MaxLength="6"
                    FontSize="24"
                    FontWeight="SemiBold"
                    TextAlignment="Center"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
